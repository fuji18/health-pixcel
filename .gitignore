# Temporary files
tmp/

# Node.js(ハーネス専用: husky / lint-staged / secretlint / prettier)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
build/

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/

# Android
android/.gradle/
android/local.properties
# Android Studio が出力する署名済み APK の置き場(ソースの android/app/src/* とは別)
android/app/debug/
android/app/profile/
android/app/release/
android/**/GeneratedPluginRegistrant.java
*.jks
*.keystore
android/key.properties

# Environment variables
.env
.env.local
.env.*.local

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
coverage/
.nyc_output/

# Steering files (.steering/) は履歴としてコミットする(CLAUDE.md の方針に従う)

# Lock files (keep package-lock.json for consistency)
# yarn.lock

.claude/settings.local.json
.claude/.lint-on-edit.lock

# devcontainer が features 解決時に生成するロックファイル(環境ごとに揺れるため追跡しない)
.devcontainer/devcontainer-lock.json

# Codex 併用ハーネスのローカル状態
# .harness/ を丸ごと無視しないこと: .harness/decisions.jsonl は
# 「削除禁止・追記のみ」の永続ログで、追跡対象に残す必要がある。
.harness/mode
.harness/codex-runs/
